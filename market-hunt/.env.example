# Copy to .env at repo root (market-hunt/.env). NEVER commit the real .env.
# --- API guard: required header X-API-Key for /api/broker/* when set.
# Leave unset for localhost-only development (non-localhost then gets 403).
MH_API_TOKEN=

# --- Zerodha Kite Connect app (developers.kite.trade) — read-only usage.
KITE_API_KEY=
KITE_API_SECRET=

# --- Dhan (web.dhan.co -> My Profile -> DhanHQ Trading APIs -> generate token)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# MH_TOKEN_KEY is auto-generated on first Kite login (encrypts .secrets/ cache).

# --- Telegram notifications (Stage 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Additional Dhan accounts (multi-account): alias pattern
# DHAN_CLIENT_ID__FAMILY=110xxxxxxx
# DHAN_ACCESS_TOKEN__FAMILY=eyJ...

# --- Stage 2 execution (kill switch + caps)
MH_TRADING_ENABLED=false
MH_MAX_ORDER_VALUE=200000
MH_MAX_EXECUTION_VALUE=2000000

# Market-hours guard: set false ONLY for off-hours broker testing
MH_MARKET_HOURS_CHECK=true

# --- Infrastructure (settings.py) — defaults shown; override per environment
# MH_MONGO_URI=mongodb://localhost:27017/
# MH_DB_NAME=market_hunt
# MH_API_HOST=127.0.0.1
# MH_API_PORT=3001
# MH_CORS_ORIGINS=http://localhost:3000,http://localhost:3300
