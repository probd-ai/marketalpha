# ---------------------------------------------------------------- secrets
# NEVER relax these. market-hunt/.env carries LIVE broker credentials
# (DHAN_ACCESS_TOKEN, KITE_API_SECRET, TELEGRAM_BOT_TOKEN, MH_API_TOKEN).
# `.env` matches at every depth; the explicit paths below are belt-and-braces.
.env
*.env
.env.*
!.env.example
!*.env.example
market-hunt/.env
backend/.env
frontend/.env.local
*.pem
*.key
.superpowers/

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/
build/

# ---------------------------------------------------------------- node
node_modules/
.next/
out/
.turbo/

# ---------------------------------------------------------------- caches & artefacts
backend/data/cache/
market-hunt/scripts/output/
*.log
.vscode/
.idea/
*.swp
.DS_Store

# research_grid outputs are regenerable; only scripts, the test fixtures and the report are tracked
market-hunt/scripts/research_grid/**/*.csv
market-hunt/scripts/research_grid/**/*.json
market-hunt/scripts/research_grid/**/*.png
market-hunt/scripts/research_grid/**/*.log
market-hunt/scripts/research_grid/**/*.html
market-hunt/scripts/research_grid/**/*.pyc
market-hunt/scripts/research_grid/**/__pycache__/
# ad-hoc experiment outputs in market-hunt/ (the _*.py scripts are tracked)
market-hunt/_*.json
